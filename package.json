{
  "name": "@donotdev/graphql",
  "version": "0.2.3",
  "private": false,
  "type": "module",
  "license": "MIT",
  "description": "GraphQL provider for DoNotDev — CRUD, auth, and callable adapters",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./server": {
      "types": "./src/server/index.ts",
      "import": "./src/server/index.ts",
      "default": "./src/server/index.ts"
    }
  },
  "scripts": {
    "dev": "tsc --noEmit --watch --listFiles false --listEmittedFiles false",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "type-check": "bunx tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@donotdev/core": "^0.2.3",
    "@donotdev/functions": "^0.2.3",
    "valibot": "^1.5.0"
  },
  "peerDependenciesMeta": {
    "@donotdev/functions": {
      "optional": true
    }
  },
  "devDependencies": {
    "@donotdev/core": "workspace:*",
    "@donotdev/functions": "workspace:*",
    "typescript": "^5.9.3",
    "valibot": "^1.5.0"
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "LICENSE.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/donotdev/dndev.git"
  },
  "keywords": [
    "donotdev",
    "dndev",
    "graphql",
    "auth",
    "crud",
    "react",
    "typescript"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "dependencies": {}
}
